# Server Configuration
PORT=3230
MCP_PATH=/mcp
NODE_ENV=production

# MCP Authentication (optional - leave empty to disable)
MCP_AUTH_TOKEN=

# Siigo API Configuration
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=

# API Behavior
SIIGO_TIMEOUT_MS=30000
SIIGO_MAX_RETRIES=3

# Security - Enable write operations (create/update/delete)
# Set to "true" only in controlled environments
ENABLE_WRITE_TOOLS=false

# Request Size Limits
MAX_PAYLOAD_SIZE=10mb

# Logging
LOG_LEVEL=info
